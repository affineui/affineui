# ── WidgetRef (id-addressed handle; survives refresh, safe when gone) ────────

class WidgetRef:
    def __bool__(self) -> bool: ...
    def valid(self) -> bool: ...
    def id(self) -> int: ...
    def name(self) -> str: ...
    def attr_value(self, name: str, fallback: str = "") -> str: ...
    def text_value(self) -> str: ...
    def has_attr(self, name: str) -> bool: ...
    def named(self, name: str) -> WidgetRef: ...
    def clear(self) -> WidgetRef: ...
    def text(self, text: str) -> WidgetRef: ...
    def attr(self, name: str, value: str) -> WidgetRef: ...
    def remove_attr(self, name: str) -> WidgetRef: ...
    def selector(self, name: str, value: str) -> WidgetRef: ...
    def cls(self, classes: str) -> WidgetRef: ...
    def on_click(self, callback: Callable[[], None]) -> WidgetRef: ...
    def on_change(self, callback: Callable[[str], None]) -> WidgetRef: ...
    def append(self, build: Callable[[View], None]) -> WidgetRef: ...
    def replace(self, build: Callable[[View], None]) -> WidgetRef: ...
    def find_widget(self, name: str) -> WidgetRef: ...

# ── Strongly-typed components ───────────────────────────────────────────────
# Every accessor is safe when the wrapper is not valid(): reads return
# defaults, writes no-op. WrongType wrappers stay attached (you can inspect
# .kind) but typed accessors are inert; generic attr/text/visible still work.

class _Component:
    def __init__(self) -> None: ...
    def __bool__(self) -> bool: ...
    @property
    def valid(self) -> bool: ...
    @property
    def validity(self) -> ComponentValidity: ...
    @property
    def attached(self) -> bool: ...
    @property
    def id(self) -> str: ...
    @property
    def kind(self) -> WidgetKind: ...
    visible: bool
    text: str
    def attr(self, name: str, fallback: str = "") -> str: ...
    def set_attr(self, name: str, value: str) -> None: ...

class Button(_Component):
    label: str
    enabled: bool
    def on_click(self, callback: Callable[[], None]) -> None: ...

class Checkbox(_Component):
    checked: bool
    def on_change(self, callback: Callable[[str], None]) -> None: ...

class TextField(_Component):
    value: str
    def on_change(self, callback: Callable[[str], None]) -> None: ...

class Dropdown(_Component):
    selected: str
    def on_change(self, callback: Callable[[str], None]) -> None: ...

class Slider(_Component):
    def value(self, fallback: float = 0.0) -> float: ...
    def on_change(self, callback: Callable[[str], None]) -> None: ...

class ColorField(_Component):
    color: str
    def on_change(self, callback: Callable[[str], None]) -> None: ...

class DockPanel(_Component):
    active_tab: str

class Foldout(_Component):
    open: bool

# ── Declarative docking (document_view / dockpanel) ─────────────────────────

class Dock:
    Left: Dock
    Right: Dock
    Top: Dock
    Bottom: Dock
    Tab: Dock

class DockCorner:
    TopLeft: DockCorner
    TopRight: DockCorner
    BottomLeft: DockCorner
    BottomRight: DockCorner

class DockHandle:
    id: str
    def __bool__(self) -> bool: ...
    def toolbar(self, build: Callable[[View], None]) -> DockHandle: ...

class DockLocation:
    def __init__(self) -> None: ...
    @staticmethod
    def docked(side: Dock, px: int = 0) -> DockLocation: ...
    @staticmethod
    def tab() -> DockLocation: ...
    @staticmethod
    def floating(anchor: DockCorner, pos: Tuple[int, int],
                 size: Tuple[int, int]) -> DockLocation: ...
    @staticmethod
    def tearoff(anchor: DockCorner, pos: Tuple[int, int],
                size: Tuple[int, int]) -> DockLocation: ...
    def in_(self, panel: DockHandle) -> DockLocation: ...
    def sized(self, px: int) -> DockLocation: ...
    def tearout_size(self, px: Tuple[int, int]) -> DockLocation: ...

class DockPlacement:
    present: bool
    floating: bool
    parent: str
    side: int
    size: int
    x: int
    y: int
    w: int
    h: int
    def __init__(self) -> None: ...

class DockLayout:
    """Opaque dock-arrangement snapshot (Document.dock_layout()); hand it
    back verbatim via View.set_dock_layout_provider."""
    present: bool
    def __init__(self) -> None: ...

