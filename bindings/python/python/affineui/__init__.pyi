    def begin(self) -> None: ...
    def end(self) -> None: ...
    def clear(self) -> None: ...
    def selector(self, name: str, value: str) -> View: ...

    def set_framework_version(self, version: str) -> None: ...
    def framework_version(self) -> str: ...

    # Controls.
    def button(self, label: str, primary: bool = False, key: str = "") -> WidgetRef: ...
    def checkbox(self, label: str, checked: bool, key: str = "") -> WidgetRef: ...
    def toggle(self, label: str, on: bool, key: str = "") -> WidgetRef: ...
    def input(self, label: str, value: str = "", type: str = "text", key: str = "") -> WidgetRef: ...
    def password(self, label: str, value: str = "", key: str = "") -> WidgetRef: ...
    def textarea(self, label: str, value: str = "", rows: int = 3, key: str = "") -> WidgetRef: ...
    def dropdown(self, label: str, options: Sequence[str], selected: str = "", key: str = "") -> WidgetRef: ...
    def button_group(self, label: str, options: Sequence[str], selected: str = "", key: str = "") -> WidgetRef: ...
    def slider(self, label: str, value: float, min: float = 0.0, max: float = 1.0, key: str = "") -> WidgetRef: ...
    def knob(self, label: str, value: float, min: float = 0.0, max: float = 1.0, bipolar: bool = False, key: str = "") -> WidgetRef: ...
    def combo(self, label: str, value: float, step: float = 0.01, key: str = "") -> WidgetRef: ...

    # Generic structure.
    def container(self, classes: str = "", key: str = "", build: Optional[Callable[[View], None]] = ...) -> WidgetRef: ...
    def panel(self, key: str = "", build: Optional[Callable[[View], None]] = ...) -> WidgetRef: ...
    def element(self, tag: str, classes: str = "", key: str = "", build: Optional[Callable[[View], None]] = ...) -> WidgetRef: ...
    def card(self, title: str, classes: str = "", key: str = "", build: Optional[Callable[[View], None]] = ...) -> WidgetRef: ...
    def foldout(self, title: str, expanded: bool = True, key: str = "", build: Optional[Callable[[View], None]] = ...) -> WidgetRef: ...
    def heading(self, level: int, text: str, classes: str = "", key: str = "") -> WidgetRef: ...
    def paragraph(self, text: str, classes: str = "", key: str = "") -> WidgetRef: ...
    def text(self, text: str, key: str = "") -> WidgetRef: ...
    def html(self, markup: str, key: str = "") -> WidgetRef: ...

    # App-shell / structural components.
    def toolbar(self, key: str = "", build: Optional[Callable[[View], None]] = ...) -> WidgetRef: ...
    def toolbar_separator(self, key: str = "") -> WidgetRef: ...
    def icon_button(self, icon: str, key: str = "") -> WidgetRef: ...
    def menu_bar(self, key: str = "", build: Optional[Callable[[View], None]] = ...) -> WidgetRef: ...
    @overload
    def menu_button(self, label: str, menu_id: str, key: str = "") -> WidgetRef: ...
    @overload
    def menu_button(self, label: str, build: Callable[[View], None], key: str = "") -> WidgetRef: ...
    def menu(self, menu_id: str, build: Callable[[View], None]) -> WidgetRef: ...
    def menu_item(self, label: str, icon: str = "", shortcut: str = "", key: str = "") -> WidgetRef: ...
    def menu_item_custom(self, key: str = "", build: Optional[Callable[[View], None]] = ...) -> WidgetRef: ...
    def menu_separator(self, key: str = "") -> WidgetRef: ...
    def submenu(self, label: str, build: Callable[[View], None], icon: str = "", key: str = "") -> WidgetRef: ...
    def menu_brand(self, title: str, icon: str = "", key: str = "") -> WidgetRef: ...
    def menu_spacer(self, key: str = "") -> WidgetRef: ...
    def menu_meta(self, text: str, key: str = "") -> WidgetRef: ...
    def dock_panel(self, title: str, tabpanel_id: str, classes: str = "", key: str = "", build: Optional[Callable[[View], None]] = ...) -> WidgetRef: ...

    # Declarative docking workspace.
    def document_view(self, key: str, build: Callable[[View], None]) -> WidgetRef: ...
    def document(self, content: Callable[[View], None], title: str = "", icon: str = "") -> DockHandle: ...
    def dockpanel(self, title: str, where: DockLocation, content: Callable[[View], None], icon: str = "", key: str = "") -> DockHandle: ...
    def set_dock_layout_provider(self, fn: Callable[[], DockLayout]) -> None: ...
    def set_dock_placement_provider(self, fn: Callable[[str], DockPlacement]) -> None: ...
    def set_dock_size_provider(self, fn: Callable[[str], int]) -> None: ...
    def set_dock_active_tab_provider(self, fn: Callable[[str], str]) -> None: ...

    def splitter(self, horizontal: bool = False, key: str = "") -> WidgetRef: ...
    def tree(self, key: str = "", build: Optional[Callable[[View], None]] = ...) -> WidgetRef: ...
    def tree_row(self, label: str, selected: bool = False, depth: int = 0, key: str = "") -> WidgetRef: ...
    def status_bar(self, key: str = "", build: Optional[Callable[[View], None]] = ...) -> WidgetRef: ...
    def color_field(self, label: str, value: str = "", swatches: Sequence[str] = ..., key: str = "") -> WidgetRef: ...
    def colorfield(self, label: str, value: str = "", key: str = "") -> WidgetRef: ...

    # Query.
    def find_widget(self, name: str) -> WidgetRef: ...
    def button_at(self, name: str) -> Button: ...
    def checkbox_at(self, name: str) -> Checkbox: ...
    def text_field_at(self, name: str) -> TextField: ...
    def dropdown_at(self, name: str) -> Dropdown: ...
    def slider_at(self, name: str) -> Slider: ...
    def color_field_at(self, name: str) -> ColorField: ...
    def dock_panel_at(self, name: str) -> DockPanel: ...
    def foldout_at(self, name: str) -> Foldout: ...

    def to_html_fragment(self) -> str: ...
    def to_html_document(self) -> str: ...

