"""Typed interface for the AffineUI Python bindings.

This stub gives editors and type checkers the full public surface of the
``affineui`` package (the compiled ``_affineui`` extension plus the small
Pythonic helpers defined in ``__init__.py``). It mirrors the C++ API: a
declarative View builder layer over a retained HTML/CSS document, plus
strongly-typed component wrappers that degrade gracefully (never crash) when a
widget is missing or of the wrong type.
"""

from __future__ import annotations

from typing import Callable, List, Optional, Sequence, Tuple, overload

__version__: str

def version() -> str: ...
def native_backend() -> str: ...

# affinetools attach — loopback devtools protocol server (discovery/auth
# via <tempdir>/affineui-tools/<pid>.json). No-ops when the native library
# was compiled with AFFINEUI_PERF=0.
def tools_listen(port: int = 0) -> bool: ...
def tools_active() -> bool: ...
def tools_port() -> int: ...
def tools_shutdown() -> None: ...

