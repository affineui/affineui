<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AffineUI</RootNamespace>
    <AssemblyName>AffineUI</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Idiomatic .NET wrapper over the AffineUI C ABI (affineui_c) — GPU-accelerated HTML/CSS UI for tools and game engines. EXPERIMENTAL preview; APIs will change.</Description>
  </PropertyGroup>

  <!-- NuGet packaging (dotnet pack). Experimental preview package. -->
  <PropertyGroup>
    <PackageId>AffineUI</PackageId>
    <Version>0.4.3</Version>
    <Authors>Benjamin Cooley</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/affineui/affineui</RepositoryUrl>
    <PackageProjectUrl>https://github.com/affineui/affineui</PackageProjectUrl>
    <PackageTags>gui;ui;html;css;native;gamedev;imgui</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Where the native affineui_c.dll comes from (repo dev build by
         default; CI overrides with per-RID artifacts). -->
    <AffineUINativeDir Condition="'$(AffineUINativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\build\ninja</AffineUINativeDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <!-- Native payload per RID. CI's `native_libs` matrix builds all
         three and drops them under $(AffineUINativeDir); local dev
         builds usually have only the host OS's native. Each Include
         is Exists()-gated so a partial build still packs (with a
         warning below when at least one RID is missing).
         NativeLibrary default probing finds them at
         runtimes/<rid>/native once installed from NuGet. -->
    <None Include="$(AffineUINativeDir)\affineui_c.dll"
          Condition="Exists('$(AffineUINativeDir)\affineui_c.dll')"
          Pack="true" PackagePath="runtimes\win-x64\native" Visible="false" />
    <None Include="$(AffineUINativeDir)\libaffineui_c.so"
          Condition="Exists('$(AffineUINativeDir)\libaffineui_c.so')"
          Pack="true" PackagePath="runtimes\linux-x64\native" Visible="false" />
    <None Include="$(AffineUINativeDir)\libaffineui_c.dylib"
          Condition="Exists('$(AffineUINativeDir)\libaffineui_c.dylib')"
          Pack="true" PackagePath="runtimes\osx-arm64\native" Visible="false" />
  </ItemGroup>

  <!-- Packing with NO native library would produce a package that can't
       load anywhere. At least one must exist. CI is expected to produce
       all three via the release.yml native_libs matrix. -->
  <Target Name="AffineUIRequireNativeForPack" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(AffineUINativeDir)\affineui_c.dll') AND !Exists('$(AffineUINativeDir)\libaffineui_c.so') AND !Exists('$(AffineUINativeDir)\libaffineui_c.dylib')"
           Text="No affineui_c native library found under '$(AffineUINativeDir)'. Build one first (cmake -DAFFINEUI_BUILD_C_SHARED=ON, target affineui_c) or set AffineUINativeDir." />
    <Warning Condition="!Exists('$(AffineUINativeDir)\affineui_c.dll')"
             Text="affineui_c.dll missing under '$(AffineUINativeDir)' — the packed NuGet will not run on Windows." />
    <Warning Condition="!Exists('$(AffineUINativeDir)\libaffineui_c.so')"
             Text="libaffineui_c.so missing under '$(AffineUINativeDir)' — the packed NuGet will not run on Linux." />
    <Warning Condition="!Exists('$(AffineUINativeDir)\libaffineui_c.dylib')"
             Text="libaffineui_c.dylib missing under '$(AffineUINativeDir)' — the packed NuGet will not run on macOS (arm64)." />
  </Target>

</Project>
