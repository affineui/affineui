*.swo
.DS_Store
Thumbs.db
*~

# Test / coverage
Testing/
*.gcno
*.gcda
*.profraw
*.profdata
coverage/

# Vendored deps are checked in under external/. Keep accidental nested
# checkout/build state out of the repository.
external/**/.git/
external/**/build/
external/**/build-*/
external/**/cmake-build-*/
external/**/_build/

# Local
.cache/
compile_commands.json
.envrc

# Python bytecode (amalgamate.py)
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Conformance harness (generated snapshots + browser deps)
conformance/out/
conformance/browser/node_modules/

# Demo runtime traces
affineui_mouse_path*.json
dock-disappear-*.log

# Local example 11 editor state / scratch exports
game_editor.prefs.toml
game_editor.workspace.toml
ex11_dump.html
conformance/cases/_ex11/
conformance/cases/_ex11ref/

# git worktrees created by agents
.claude/worktrees/

# Background agent status board (local only)
.agent-status/
build-linux/

.cibw-venv/
wheelhouse/

# Language bindings build outputs
bindings/rust/target/
bindings/csharp/**/bin/
bindings/csharp/**/obj/

# Runtime output (profiler dumps, app-written layout state)
affineui_profile.txt
affineui_trace.json
dender.workspace.toml

# CI-generated NuGet artifacts (see release.yml nuget job)
bindings/csharp/artifacts/

# affineui-sys vendored source (regenerated per release by scripts/vendor.sh)
bindings/rust/affineui-sys/vendor/

# Generated by tools/embed_decius.py — regenerated on every cmake build
include/affineui/_decius_bundle.h
.venv-vlist/
.emsdk/
